# Copy to .env and fill in. Passed to the app with:
#   flutter run --dart-define-from-file=.env
# Use the PUBLIC key only (sb_publishable_... or the legacy "anon" key).
# Never put the secret / service-role key in the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional — push notifications (Firebase Cloud Messaging). Leave empty to
# run without push; in-app alerts still work through Supabase Realtime.
# Values: Firebase console → Project settings → Your apps → Android app.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# Optional — road routing. Empty = offline Haversine × 1.3 (default).
# e.g. https://router.project-osrm.org (demo server, not for production)
OSRM_URL=

# Optional — map tiles. Empty = public OpenStreetMap tiles (development only).
TILE_URL=
